# Copy this file to .env.local (which git ignores) and restart npm run dev.
#
# The whiteboard on the Paper Globe can ask Google's Gemini what a drawing is. Get a key at https://aistudio.google.com/apikey
# Without a key the game still works: the kid taps a picture of what they drew instead.
# The key is built into the page, so use it for local demos; put a small server in front of it before putting the app online.
# The drawing (a small JPEG, nothing else) is sent to Google when a key is set.
VITE_GEMINI_API_KEY=

# Optional: which Gemini model to ask first (the app falls back to the next one if this one is not available to your key).
# VITE_GEMINI_MODEL=gemini-3.5-flash-lite

# Talking to the characters on the Paper Globe: tap one, then "Talk to ...". Gemini (the key above) writes what it says.
# ElevenLabs says it out loud. Get a key at https://elevenlabs.io/app/settings/api-keys (it needs the text-to-speech permission).
# Without it the characters still answer, in text. Only what the character says is sent to ElevenLabs.
VITE_ELEVENLABS_API_KEY=

# Optional: the four voices (male animal, female animal, mom, dad). Defaults are ElevenLabs premade voices.
# VITE_ELEVENLABS_VOICE_MALE=
# VITE_ELEVENLABS_VOICE_FEMALE=
# VITE_ELEVENLABS_VOICE_MOM=
# VITE_ELEVENLABS_VOICE_DAD=
# Or one voice for every character:
# VITE_ELEVENLABS_VOICE_ID=
